# NVIDIA GPU image. Run with: docker run --gpus all -v $PWD/data:/data -p 8765:8765 wikiengram:cuda
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/hf WIKIENGRAM_WORKSPACE=/data/workspace

WORKDIR /app
COPY pyproject.toml README.md LICENSE NOTICE ./
COPY src ./src
RUN pip install ".[api,data,mcp]"

VOLUME ["/data"]
EXPOSE 8765 8000 8766
ENTRYPOINT ["wikiengram"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8765"]
